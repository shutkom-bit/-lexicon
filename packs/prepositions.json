{
  "id": "prepositions",
  "emoji": "🔗",
  "name": "Прийменники та сполучники",
  "targetLang": "en",
  "nativeLang": "uk",
  "native2": "",
  "order": 0.5,
  "words": [
    { "word": "in",       "ipa": "/ɪn/",         "pos": "preposition", "pos_group": "other", "tr": { "uk": "в, у" },                   "def": "used to show position inside something",           "ex": "The keys are in the drawer." },
    { "word": "on",       "ipa": "/ɒn/",         "pos": "preposition", "pos_group": "other", "tr": { "uk": "на" },                     "def": "used to show position on a surface",               "ex": "The book is on the table." },
    { "word": "at",       "ipa": "/æt/",         "pos": "preposition", "pos_group": "other", "tr": { "uk": "в, на (місце чи час)" },   "def": "used for a specific place or time",                "ex": "We met at the station." },
    { "word": "to",       "ipa": "/tuː/",        "pos": "preposition", "pos_group": "other", "tr": { "uk": "до" },                     "def": "used to show direction or a destination",          "ex": "I'm going to the shop." },
    { "word": "from",     "ipa": "/frɒm/",       "pos": "preposition", "pos_group": "other", "tr": { "uk": "від, з" },                 "def": "used to show a starting point or origin",          "ex": "She comes from Poland." },
    { "word": "with",     "ipa": "/wɪð/",        "pos": "preposition", "pos_group": "other", "tr": { "uk": "з (разом із)" },           "def": "in the company of, or using something",            "ex": "Come with me to the park." },
    { "word": "for",      "ipa": "/fɔːr/",       "pos": "preposition", "pos_group": "other", "tr": { "uk": "для, за" },                "def": "showing purpose or who receives something",        "ex": "This gift is for you." },
    { "word": "of",       "ipa": "/ɒv/",         "pos": "preposition", "pos_group": "other", "tr": { "uk": "родовий відмінок; з" },    "def": "showing belonging or connection",                  "ex": "the roof of the house" },
    { "word": "about",    "ipa": "/əˈbaʊt/",     "pos": "preposition", "pos_group": "other", "tr": { "uk": "про" },                    "def": "on the subject of something",                      "ex": "a book about history" },
    { "word": "by",       "ipa": "/baɪ/",        "pos": "preposition", "pos_group": "other", "tr": { "uk": "біля; за допомогою" },     "def": "next to, or showing who does an action",           "ex": "Sit by the window." },
    { "word": "under",    "ipa": "/ˈʌndər/",     "pos": "preposition", "pos_group": "other", "tr": { "uk": "під" },                    "def": "in a lower position than something",               "ex": "The cat is under the table." },
    { "word": "over",     "ipa": "/ˈəʊvər/",     "pos": "preposition", "pos_group": "other", "tr": { "uk": "над, через" },             "def": "above or covering something",                      "ex": "A lamp hangs over the table." },
    { "word": "between",  "ipa": "/bɪˈtwiːn/",   "pos": "preposition", "pos_group": "other", "tr": { "uk": "між" },                    "def": "in the space separating two things",               "ex": "The café is between the bank and the shop." },
    { "word": "near",     "ipa": "/nɪər/",       "pos": "preposition", "pos_group": "other", "tr": { "uk": "біля, поблизу" },          "def": "close to something",                               "ex": "We live near the park." },
    { "word": "before",   "ipa": "/bɪˈfɔːr/",    "pos": "preposition", "pos_group": "other", "tr": { "uk": "перед, до" },              "def": "earlier than something",                           "ex": "Wash your hands before dinner." },
    { "word": "after",    "ipa": "/ˈɑːftər/",    "pos": "preposition", "pos_group": "other", "tr": { "uk": "після" },                  "def": "later than something",                             "ex": "We'll talk after lunch." },
    { "word": "and",      "ipa": "/ænd/",        "pos": "conjunction", "pos_group": "other", "tr": { "uk": "і, та" },                  "def": "used to join words or ideas",                      "ex": "bread and butter" },
    { "word": "but",      "ipa": "/bʌt/",        "pos": "conjunction", "pos_group": "other", "tr": { "uk": "але" },                    "def": "used to introduce a contrast",                     "ex": "It's cheap but good." },
    { "word": "or",       "ipa": "/ɔːr/",        "pos": "conjunction", "pos_group": "other", "tr": { "uk": "або, чи" },                "def": "used to show a choice between things",              "ex": "Would you like tea or coffee?" },
    { "word": "so",       "ipa": "/səʊ/",        "pos": "conjunction", "pos_group": "other", "tr": { "uk": "тому, отже" },             "def": "for that reason; therefore",                       "ex": "It was late, so we left." },
    { "word": "because",  "ipa": "/bɪˈkɒz/",     "pos": "conjunction", "pos_group": "other", "tr": { "uk": "тому що" },                "def": "for the reason that",                              "ex": "I stayed home because I was ill." },
    { "word": "if",       "ipa": "/ɪf/",         "pos": "conjunction", "pos_group": "other", "tr": { "uk": "якщо" },                   "def": "on the condition that",                            "ex": "Call me if you need help." },
    { "word": "while",    "ipa": "/waɪl/",       "pos": "conjunction", "pos_group": "other", "tr": { "uk": "поки, тоді як" },          "def": "during the time that",                             "ex": "She read while I cooked." },
    { "word": "although", "ipa": "/ɔːlˈðəʊ/",    "pos": "conjunction", "pos_group": "other", "tr": { "uk": "хоча" },                   "def": "despite the fact that",                            "ex": "We went out although it was raining." }
  ]
}
